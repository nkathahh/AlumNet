# Copy this file to .env and fill in the values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alumnet
# Hosted MySQL (Aiven): set DB_SSL=true and paste the CA certificate text into DB_SSL_CA
DB_SSL=false
DB_SSL_CA=

# Sessions: use a long random string
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Encrypts two-factor secrets in the database: 64 hex characters, generate like JWT_SECRET.
# Never change it once people have turned on two-factor (their apps would stop working).
TOTP_ENC_KEY=

# Encrypts backups made with "npm run backup": 64 hex characters, generated the same way.
# Keep a copy somewhere other than the backups: without it a backup cannot be restored.
BACKUP_KEY=

# Where photos and images are kept. "local" (the default) uses backend/uploads on this
# computer. On Render, whose disk is wiped on every deploy, use "s3" with a Cloudflare R2
# bucket (free up to 10 GB) or Amazon S3. Keep the bucket private: AlumNet serves the images.
MEDIA_DRIVER=local
# MEDIA_DIR=
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Admins must use two-factor authentication. Set to false ONLY on your own laptop.
ADMIN_2FA_REQUIRED=true

# Matching service
ML_SERVICE_URL=http://localhost:5000
# Shared secret with the ML service (leave empty locally)
ML_API_KEY=

# Google sign-in: OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Email, option 1: Gmail with an app password
SMTP_USER=
SMTP_PASS=
# Email, option 2: Brevo API (use on hosts that block SMTP)
BREVO_API_KEY=
MAIL_FROM=
# Send every email to this inbox instead of the real recipient (demo safety)
MAIL_DEV_REDIRECT=

# Only needed if the frontend is hosted on a different domain
CORS_ORIGIN=
